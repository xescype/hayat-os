# HAYAT OS — ortam degiskenleri (Bolum 16)
# Kopyala: cp .env.example .env  ; sonra gercek degerleri doldur.
# Faz 0 LOKAL: DOMAIN=localhost yeterli.

# --- Cekirdek ---
DOMAIN=localhost
# Ilk passkey kaydini koruyan tek kullanimlik uzun rastgele dize. Uret: openssl rand -hex 32
SETUP_TOKEN=change-me-openssl-rand-hex-32
# Postgres. Compose ici: postgres://hayatos:hayatos@db:5432/hayatos
DATABASE_URL=postgres://hayatos:hayatos@db:5432/hayatos
PORT=3000
TZ=Europe/Istanbul
NODE_ENV=development

# --- Sifreleme ---
# Dosya sifreleme ana anahtari (32 bayt base64). Uret: openssl rand -base64 32. KAYBI = foto/ses kaybi.
SODIUM_MASTER_KEY=
# Yedek tar'larini sifreleyen age anahtari. Public kismi burada yeter; private SADECE parola kasasinda.
BACKUP_AGE_KEY=

# --- Web Push (VAPID) ---
# Uret: npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:yilmazsafa77@gmail.com

# --- Google Calendar OAuth (Faz 1'de kullanilir) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Vertex AI (gunduz beyni; Faz 0'da yalniz health) ---
# Service account json dosya yolu (compose'a mount edilir) veya GEMINI_API_KEY (AI Studio fallback).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_API_KEY=

# --- Cloud TTS (Faz 2) ---
GCP_TTS_KEY=

# --- Yedek (GCS) — Faz 0'da GERCEK bucket'a test edilir ---
GCS_BACKUP_BUCKET=

# --- OpenRouter (gece muhasebecisi; Faz 3) ---
OPENROUTER_API_KEY=
AUDITOR_MODEL=
AUDITOR_PROVIDER=

# --- Maliyet korkuluklari (gunluk cagri tavanlari) ---
FLASH_DAILY_CAP=200
PRO_DAILY_CAP=5
AUDITOR_DAILY_CAP=2
TTS_DAILY_CAP=60

# --- Bildirim ---
QUIET_HOURS=23:00-07:30
