{
  "name": "hayat-os",
  "version": "0.0.0",
  "private": true,
  "description": "Hayat OS — tek kullanicilik kisisel hayat isletim sistemi",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
